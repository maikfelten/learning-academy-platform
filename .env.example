# Platform configuration.
# Copy this file to `.env` and adjust, or set the values as real environment
# variables. Without a .env the defaults from server/config.js apply.
#
# Node reads the file when started with `node --env-file=.env server/index.js`.
# The start scripts do that automatically when a .env is present.

# Platform name (page title, login screen, loading state)
PLATTFORM_NAME=Learning Academy

# Organisation name (certificate, login text, department overview)
ORGANISATION=Beispiel GmbH

# Contact address for password resets and questions
SUPPORT_EMAIL=schulung@example.com

# Email domain used for the placeholder in the sign-in form
EMAIL_DOMAIN=example.com

# Optional tagline in the certificate footer (leave empty to omit it)
CLAIM=

# Certificate number prefix, e.g. ZERT-2026-000123
ZERTIFIKAT_PRAEFIX=ZERT

# Port the local server listens on
PORT=5180
